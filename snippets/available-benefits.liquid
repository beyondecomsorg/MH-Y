{% comment %}
  ==============================================================================
  SNIPPET: available-benefits.liquid
  ==============================================================================
  Renders an "Available Benefits" carousel with 4 coupon cards (including click-to-copy).
{% endcomment %}

{% liquid
  assign block_id = block.id | default: section.id
  assign heading = block.settings.heading | default: "AVAILABLE BENEFITS"
  assign accent_color = block.settings.accent_color | default: "#b8860b"

  # Offer 1 - Free Shipping
  assign card1_desc = block.settings.description_1 | default: "Free shipping on all orders."

  # Offer 2 - Extra 5% OFF
  assign card2_code = block.settings.coupon_code_2 | default: "MHY5"
  assign card2_desc = block.settings.description_2 | default: "Get an extra 5% OFF on purchases of ₹10,000 and above."
  assign card2_tnc_url = block.settings.tnc_url_2 | default: "#"
  assign card2_tnc_text = block.settings.tnc_text_2 | default: "T & C"
%}

{% capture cards_html %}

  <!-- Offer 1 - Free Shipping -->
<!-- Offer 1 - Free Shipping -->
<div class="ab-card">
  <div class="ab-row-top">
    <div class="ab-code-wrapper">
      <strong class="ab-offer-title">Free Shipping</strong>
    </div>
  </div>

  <p class="ab-description">
    Enjoy free shipping on every order.
  </p>

  <p class="ab-offer-note">
    No code required • Automatically applied
  </p>
</div>

  <!-- Offer 2 - Extra 5% OFF -->
  <div class="ab-card">
    <div class="ab-row-top">
      <div class="ab-code-wrapper">
        <span>Use code</span>

        <button
          type="button"
          class="ab-code-btn js-ab-code-btn"
          title="Click to copy coupon code {{ card2_code }}"
          aria-label="Click to copy coupon code {{ card2_code }}"
        >
          <span
            class="js-ab-code-text"
            data-code="{{ card2_code }}"
          >
            {{ card2_code }}
          </span>

          <span
            class="ab-copy-badge js-ab-copy-feedback"
            aria-live="polite"
          ></span>
        </button>
      </div>

      {% if card2_tnc_text != blank %}
        <a
          href="{{ card2_tnc_url }}"
          class="ab-tnc-link"
        >
          {{ card2_tnc_text }}
        </a>
      {% endif %}
    </div>

    <p class="ab-description">
      {{ card2_desc }}
    </p>
  </div>

{% endcapture %}

<style>
  #ab-block-{{ block_id }} {
    width: 100%;
    margin-top: 16px;
    margin-bottom: 16px;
    box-sizing: border-box;
    overflow: hidden;
  }

  #ab-block-{{ block_id }} .ab-heading {
    font-size: 12px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    font-weight: 600;
    margin: 0 0 10px 0;
    color: #11172b;
  }

  #ab-block-{{ block_id }} .ab-marquee-wrapper {
    width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    padding-bottom: 8px;
    position: relative;
  }

  /* Thin scrollbar for desktop */
  @media screen and (min-width: 741px) {
    #ab-block-{{ block_id }} .ab-marquee-wrapper::-webkit-scrollbar {
      height: 4px;
    }
    #ab-block-{{ block_id }} .ab-marquee-wrapper::-webkit-scrollbar-track {
      background: #f1f1f1;
    }
    #ab-block-{{ block_id }} .ab-marquee-wrapper::-webkit-scrollbar-thumb {
      background: #c1c1c1;
      border-radius: 2px;
    }
  }

  #ab-block-{{ block_id }} .ab-marquee-track {
    display: flex;
    width: max-content;
    align-items: stretch;
    user-select: none;
  }

  #ab-block-{{ block_id }} .ab-marquee-content {
    display: flex;
    flex-shrink: 0;
    align-items: stretch;
    gap: 16px;
    padding-right: 16px;
  }

  /* Desktop css animation */
  @media screen and (min-width: 741px) {
    #ab-block-{{ block_id }} .ab-marquee-content {
      /* animation: ab-scroll-marquee-{{ block_id }} 30s linear infinite; */
    }
    #ab-block-{{ block_id }} .ab-marquee-track:hover .ab-marquee-content {
      animation-play-state: paused;
    }
  }

  #ab-block-{{ block_id }} .ab-card {
  border: 1px dashed #d1d1d1;
  padding: 14px 16px;
  background-color: #fafafa;
  border-radius: 2px;
  box-sizing: border-box;
  width: 300px;
  min-height: 110px;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  flex-shrink: 0;
  }
  #ab-block-{{ block_id }} .ab-offer-title {
  font-size: 13px;
  line-height: 1.4;
  font-weight: 700;
  color: #333333;
}
.ab-code-wrapper{
height: 0px;
line-height: 0px;}

button.ab-code-btn.js-ab-code-btn{
line-height: 0;
}
#ab-block-{{ block_id }} .ab-offer-note {
  font-size: 12px;
  line-height: 1.45;
  color: #555555;
  margin: 0;
}

  #ab-block-{{ block_id }} .ab-row-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  min-height: 24px;
  margin-bottom: 12px;
  flex-wrap: nowrap;
  }

  #ab-block-{{ block_id }} .ab-code-wrapper {
    font-size: 13px;
    color: #333333;
    display: flex;
    align-items: center;
    gap: 6px;
  }
  
.ab-offer-note{
font-size: 12px;}

  #ab-block-{{ block_id }} .ab-code-btn {
    background: transparent;
    border: none;
    padding: 0;
    margin: 0;
    font-family: inherit;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 1px;
    color: {{ accent_color }};
    text-decoration: underline;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    position: relative;
    transition: opacity 0.15s ease;
  }

  #ab-block-{{ block_id }} .ab-code-btn:hover {
    opacity: 0.8;
  }

  #ab-block-{{ block_id }} .ab-copy-badge {
    display: inline-block;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    background-color: #11172b;
    color: #ffffff;
    padding: 2px 6px;
    border-radius: 3px;
    opacity: 0;
    transform: translateY(-2px);
    transition: opacity 0.2s ease, transform 0.2s ease;
    pointer-events: none;
  }

  #ab-block-{{ block_id }} .ab-code-btn.copied .ab-copy-badge {
    opacity: 1;
    transform: translateY(0);
  }

  #ab-block-{{ block_id }} .ab-tnc-link {
    font-size: 12px;
    color: #555555;
    text-decoration: underline;
    font-weight: 500;
    transition: color 0.15s ease;
    white-space: nowrap;
  }

  #ab-block-{{ block_id }} .ab-tnc-link:hover {
    color: #11172b;
  }

  #ab-block-{{ block_id }} .ab-description {
    font-size: 13px;
    line-height: 1.45;
    color: #555555;
    margin: 0;
  }

  @keyframes ab-scroll-marquee-{{ block_id }} {
    0% {
      transform: translate3d(0, 0, 0);
    }
    100% {
      transform: translate3d(-100%, 0, 0);
    }
  }

  /* Mobile style overrides */
  @media screen and (max-width: 740px) {
    #ab-block-{{ block_id }} .ab-marquee-wrapper {
      overflow-x: auto !important;
      -webkit-overflow-scrolling: touch !important;
      scrollbar-width: none !important;
    }
    #ab-block-{{ block_id }} .ab-marquee-wrapper::-webkit-scrollbar {
      display: none !important;
    }
    #ab-block-{{ block_id }} .ab-marquee-wrapper.is-snapping {
      scroll-snap-type: x mandatory !important;
    }
    #ab-block-{{ block_id }} .ab-marquee-wrapper.is-snapping .ab-card {
      scroll-snap-align: start !important;
    }
    #ab-block-{{ block_id }} .ab-card {
      width: 77vw !important;
    }
    #ab-block-{{ block_id }} .ab-marquee-content {
      gap: 16px !important;
      padding-right: 16px !important;
    }
  }

  /* Reduce motion */
  @media (prefers-reduced-motion: reduce) {
    #ab-block-{{ block_id }} .ab-marquee-content {
      animation: none !important;
    }
  }
</style>

<div id="ab-block-{{ block_id }}" class="ab-container" {{ block.shopify_attributes }}>
  {% if heading != blank %}
    <h4 class="ab-heading">{{ heading }}</h4>
  {% endif %}

  <div class="ab-marquee-wrapper">
    <div class="ab-marquee-track">
      <div class="ab-marquee-content">
        {{ cards_html }}
      </div>
      <div class="ab-marquee-content" aria-hidden="true">
        {{ cards_html }}
      </div>
      <div class="ab-marquee-content" aria-hidden="true">
        {{ cards_html }}
      </div>
    </div>
  </div>
</div>

<script>
  (function() {
    const container = document.getElementById('ab-block-{{ block_id }}');
    if (!container) return;

    const wrapper = container.querySelector('.ab-marquee-wrapper');
    const track = container.querySelector('.ab-marquee-track');
    if (!wrapper || !track) return;

    // Click-to-copy handler
    const buttons = container.querySelectorAll('.js-ab-code-btn');
    buttons.forEach(btn => {
      btn.addEventListener('click', function(e) {
        e.preventDefault();
        const codeSpan = btn.querySelector('.js-ab-code-text');
        const feedback = btn.querySelector('.js-ab-copy-feedback');
        if (!codeSpan) return;

        const codeToCopy = codeSpan.getAttribute('data-code') || codeSpan.textContent.trim();

        const handleSuccess = () => {
          btn.classList.add('copied');
          if (feedback) feedback.textContent = 'Copied!';
          setTimeout(() => {
            btn.classList.remove('copied');
            if (feedback) feedback.textContent = '';
          }, 1800);
        };

        if (navigator.clipboard && window.isSecureContext) {
          navigator.clipboard.writeText(codeToCopy).then(handleSuccess).catch(fallbackCopy);
        } else {
          fallbackCopy();
        }

        function fallbackCopy() {
          const textarea = document.createElement('textarea');
          textarea.value = codeToCopy;
          textarea.style.position = 'fixed';
          textarea.style.opacity = '0';
          document.body.appendChild(textarea);
          textarea.focus();
          textarea.select();
          try {
            document.execCommand('copy');
            handleSuccess();
          } catch (err) {
            console.error('Fallback copy failed', err);
          }
          document.body.removeChild(textarea);
        }
      });
    });

    // Mobile Auto-scroll loop
    let isMobile = window.innerWidth <= 740;
    let autoScroll = true;
    const scrollSpeed = 0.5; // pixels per frame
    let scrollTimeout = null;

    function checkMode() {
      isMobile = window.innerWidth <= 740;
      if (!isMobile) {
        wrapper.classList.remove('is-snapping');
      }
    }
    window.addEventListener('resize', checkMode);
    checkMode();

    let lastTime = performance.now();
    function updateScroll(timestamp) {
      const delta = timestamp - lastTime;
      lastTime = timestamp;

      if (autoScroll && isMobile) {
        const firstGroup = track.querySelector('.ab-marquee-content');
        if (firstGroup) {
          const groupWidth = firstGroup.offsetWidth;
          wrapper.scrollLeft += scrollSpeed * (delta / 16.67);

          if (wrapper.scrollLeft >= groupWidth) {
            wrapper.scrollLeft -= groupWidth;
          }
        }
      }
      requestAnimationFrame(updateScroll);
    }
    requestAnimationFrame(updateScroll);

    wrapper.addEventListener('touchstart', function() {
      autoScroll = false;
      wrapper.classList.add('is-snapping');
      if (scrollTimeout) clearTimeout(scrollTimeout);
    }, { passive: true });

    wrapper.addEventListener('touchend', function() {
      if (scrollTimeout) clearTimeout(scrollTimeout);
      scrollTimeout = setTimeout(function() {
        wrapper.classList.remove('is-snapping');
        autoScroll = true;
      }, 2000);
    }, { passive: true });
  })();
</script>
