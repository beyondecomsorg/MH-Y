{% comment %}
  mf-mobile-filter.liquid
  ──────────────────────────────────────────────────────────────
  New Mobile Filter & Sort UI — completely independent.
  Renders only on collection pages.
  Requires: mf-mobile-filter.css, mf-mobile-filter.js
  ──────────────────────────────────────────────────────────────
{% endcomment %}

{%- liquid
  assign mf_active_count = 0
  for filter in collection.filters
    assign mf_active_count = mf_active_count | plus: filter.active_values.size
    if filter.type == 'price_range'
      if filter.min_value.value or filter.max_value.value
        assign mf_active_count = mf_active_count | plus: 1
      endif
    endif
  endfor
-%}

{%- comment -%} ── Filter + Sort Data Payload ── {%- endcomment -%}
<script id="mf-data" type="application/json">
{
  "filters": [
    {%- for filter in collection.filters -%}
    {
      "label": {{ filter.label | json }},
      "type": {{ filter.type | json }},
      {%- if filter.type == 'list' or filter.type == 'boolean' -%}
      "values": [
        {%- for value in filter.values -%}
        {
          "label": {{ value.label | json }},
          "count": {{ value.count }},
          "active": {{ value.active | json }},
          "paramName": {{ value.param_name | json }},
          "value": {{ value.value | json }}
        }{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      ]
      {%- elsif filter.type == 'price_range' -%}
      "values": [],
      "minParamName": {{ filter.min_value.param_name | json }},
      "maxParamName": {{ filter.max_value.param_name | json }},
      "rangeMax": {{ filter.range_max | default: 100000 }},
      "currentMin": {{ filter.min_value.value | default: "" | json }},
      "currentMax": {{ filter.max_value.value | default: "" | json }}
      {%- else -%}
      "values": []
      {%- endif -%}
    }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ],
  "sortOptions": [
    {%- for option in collection.sort_options -%}
    {
      "name": {{ option.name | json }},
      "value": {{ option.value | json }},
      {%- if option.value == collection.sort_by -%}
        "active": true
      {%- else -%}
        "active": false
      {%- endif -%}
    }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ],
  "collectionUrl": {{ collection.url | json }}
}
</script>

{%- comment -%} ── Bottom Sticky Toolbar ── {%- endcomment -%}
<div class="mf-toolbar" id="mf-toolbar" role="toolbar" aria-label="Filter and sort">
  <button class="mf-toolbar__btn" id="mf-btn-filters" type="button" aria-haspopup="dialog">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
      <line x1="4" y1="6" x2="20" y2="6"/>
      <line x1="8" y1="12" x2="16" y2="12"/>
      <line x1="11" y1="18" x2="13" y2="18"/>
    </svg>
    Filters
    {%- if mf_active_count > 0 -%}
      <span class="mf-toolbar__badge" id="mf-toolbar-badge">{{ mf_active_count }}</span>
    {%- else -%}
      <span class="mf-toolbar__badge" id="mf-toolbar-badge" style="display:none"></span>
    {%- endif -%}
  </button>
  <div class="mf-toolbar__divider" aria-hidden="true"></div>
  <button class="mf-toolbar__btn" id="mf-btn-sort" type="button" aria-haspopup="dialog">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M3 6h18M7 12h10M11 18h2"/>
    </svg>
    Sort by
  </button>
</div>

{%- comment -%} ── Backdrop Overlay ── {%- endcomment -%}
<div class="mf-overlay" id="mf-overlay" aria-hidden="true"></div>

{%- comment -%} ── Filter Drawer ── {%- endcomment -%}
<div class="mf-filter-drawer" id="mf-filter-drawer" role="dialog" aria-modal="true" aria-label="Filters" aria-hidden="true">
  <div class="mf-drawer__handle" aria-hidden="true"></div>
  <div class="mf-drawer__header">
    <h2 class="mf-drawer__title">Filters by</h2>
    <button class="mf-drawer__close" id="mf-close-filter" type="button" aria-label="Close filter panel">
      <svg width="11" height="11" viewBox="0 0 11 11" fill="none">
        <path d="M1 1L10 10M10 1L1 10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
      </svg>
    </button>
  </div>

  <div class="mf-filter-drawer__body">
    <div class="mf-filter__groups" id="mf-groups" role="tablist" aria-label="Filter categories"></div>
    <div class="mf-filter__values" id="mf-values" role="group" aria-label="Filter options"></div>
  </div>

  <div class="mf-drawer__footer">
    <button class="mf-btn-clear" id="mf-clear-all" type="button">Clear All</button>
    <button class="mf-btn-apply" id="mf-apply" type="button">Apply Filter</button>
  </div>
</div>

{%- comment -%} ── Sort Drawer ── {%- endcomment -%}
<div class="mf-sort-drawer" id="mf-sort-drawer" role="dialog" aria-modal="true" aria-label="Sort options" aria-hidden="true">
  <div class="mf-drawer__handle" aria-hidden="true"></div>
  <div class="mf-drawer__header">
    <h2 class="mf-drawer__title">Sort by</h2>
    <button class="mf-drawer__close" id="mf-close-sort" type="button" aria-label="Close sort panel">
      <svg width="11" height="11" viewBox="0 0 11 11" fill="none">
        <path d="M1 1L10 10M10 1L1 10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
      </svg>
    </button>
  </div>
  <div class="mf-sort__list" id="mf-sort-list" role="listbox" aria-label="Sort options"></div>
</div>

{%- comment -%} ── Load Assets ── {%- endcomment -%}
{{ 'mf-mobile-filter.css' | asset_url | stylesheet_tag }}
<script src="{{ 'mf-mobile-filter.js' | asset_url }}" defer></script>
