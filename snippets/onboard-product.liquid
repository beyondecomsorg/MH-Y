{% comment %}Used for home page sections only when featured products is chosen but no content has been selected{% endcomment %}

{% for i in (1..prod_limit) %}
  {% capture current %}{% cycle 1, 2, 3, 4, 5 %}{% endcapture %}
  {%- assign placeholder = 'product-' | append: current -%}
  <div class="fffff featured__collection-product product-index"
    data-aos="fade"
    data-aos-delay="{{ forloop.index | minus: 1 | modulo: aos_mod | times: 100 }}">
    <div class="onboard">
        <div class="reveal">
          {{ placeholder | placeholder_svg_tag }}
        </div>
      </a>
    </div>
    <div class="product-info">
      <div class="product-info-inner">
        <a href="#">
          <span class="prod-title">{{ 'products.onboarding.sample_product' | t: index: forloop.index }}</span>
        </a>
        <div class="price">
          9.99
        </div>
      </div>
    </div>
  </div>
{% endfor %}
