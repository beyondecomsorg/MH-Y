{%
  render 'announcement-bar',
  section: section,
  block: block
%}

{%- liquid
  if settings.cart_type == 'drawer'
    assign cart_classes = 'js-slideout-open'
    assign cart_settings = 'data-wau-slideout-target="ajax-cart" data-slideout-direction="right"'
  elsif settings.cart_type == 'modal_cart'
    assign cart_classes = 'js-modal-open'
    assign cart_settings = 'data-wau-modal-target="ajax-cart"'
  endif
-%}

{% capture search %}
{%- if settings.predictive_search_enabled -%}
<predictive-search
  data-routes="{{ routes.predictive_search_url | default: '/search/suggest' }}"
  data-input-selector='input[name="q"]'
  data-results-selector="#predictive-search-header">
{%- endif -%}
  <form action="{{ routes.search_url }}" method="get" class="header-search-form">
    <div class="header-search-form__inner">
      <label class="visuallyhidden" for="header-search">{{ 'sections.search.placeholder' | t }}</label>
      <input
        type="text"
        class="header-search"
        name="q"
        id="header-search"
        placeholder="{{ 'sections.search.placeholder' | t }}"
        value="{{ search.terms | escape }}"
        {%- if settings.predictive_search_enabled -%}
          role="combobox"
          aria-expanded="false"
          aria-owns="predictive-search-results-list"
          aria-controls="predictive-search-results-list"
          aria-haspopup="listbox"
          aria-autocomplete="list"
          autocorrect="off"
          autocomplete="off"
          autocapitalize="off"
          spellcheck="false"
        {%- endif -%} />
      <button type="submit" class="search-button">
        {% render 'snip-icons',
           wrapper: '.slideout__trigger-search',
           type: 'apollo',
           icon: 'search',
           classes: 'vib-center',
           size: '14px',
           fill: 'var(--cart-links)',
           hover: 'var(--cart-links)' %}
      </button>
    </div>
    <input name="options[prefix]" type="hidden" value="last">
    {% if settings.search_show_products_only %}
      <input type="hidden" name="type" value="product">
    {% endif %}
    {%- if settings.predictive_search_enabled -%}
      <div id="predictive-search-header" class="predictive-search" tabindex="-1"></div>
    {%- endif -%}
  </form>
{%- if settings.predictive_search_enabled -%}
</predictive-search>
{%- endif -%}
{% endcapture %}

<style>
.mobile-menu-sale-wrapper {
  position: relative;
  display: inline-block;
}

.sale-badge {
  position: absolute;
  top: 0px;
  right: -18px;
  background: #ff2d2d;
  color: #fff;
  font-size: 9px;
  font-weight: 700;
  line-height: 1;
  padding: 3px 6px;
  border-radius: 20px;
  z-index: 9;
  text-transform: capitalize;
}

.sale-badge::after {
  content: '';
  position: absolute;
  bottom: -3px;
  left: 8px;
  width: 6px;
  height: 6px;
  background: #ff2d2d;
  transform: rotate(45deg);
}
@media (min-width: 769px) {
  .sale-badge {
    display: none;
  }
}
</style>

<theme-header>
<div class="header-section js-header-section" data-section-id="{{ section.id }}" data-section-type="header-section">

  <header
    data-sticky-class="header--sticky"
    class="theme-header{% if section.settings.header_layout contains 'inline' %} stickynav{% endif %}{% if section.settings.full_width_announcement_bar %} gridlock-fluid{% endif %}{% if request.page_type != 'index' %} not-home{% endif %}">

    <div id="identity" class="header--container row">

<div class="mobile-menu__trigger mobile-only">
  <div class="slideout__trigger--open text-left mobile-menu-sale-wrapper">

    {% comment %} <span class="sale-badge">Sale</span> {% endcomment %}

    <button
      class="slideout__trigger-mobile-menu js-slideout-open text-left"
      data-wau-slideout-target="mobile-navigation"
      data-slideout-direction="left"
      aria-label="Open navigation"
      tabindex="0"
      type="button"
      name="button">

      {% render 'snip-icons',
         wrapper: '.slideout__trigger-mobile-menu',
         type: 'apollo',
         icon: 'menu-bars',
         classes: 'slideout__trigger-mobile-menu--icon vib-center',
         size: '16px',
         fill: 'var(--cart-links)',
         hover: 'var(--cart-links)' %}

    </button>
  </div>
</div>
      {% if section.settings.header_layout == 'center' %}
        <div class="large-search">
          {% if section.settings.search_layout == 'visible' %}
            {{ search }}
          {% endif %}
        </div>
      {% endif %}

      {%- comment -%}
        FIX: Added explicit width/height on logo container to prevent CLS.
        Logo images already have loading="eager" fetchpriority="high" — correct.
        Added contain:layout on wrapper to isolate logo reflow from rest of page.
      {%- endcomment -%}
      <div id="logo" class="theme__logo" style="contain:layout">
        <div class="logo--default{% if request.page_type != 'index' %} logo_hidden{% endif %}">
          {% if section.settings.logo != blank %}
            <a href="{{ routes.root_url }}">
              {%
                render 'basic-responsive-image',
                type: section.settings.logo,
                width: 1200,
                alt: 'MH&Y India Premium Menswear Logo',
                loading: 'eager',
                fetchpriority: 'high'
              %}
            </a>
          {% else %}
            <a href="{{ routes.root_url }}">{{ shop.name }}</a>
          {% endif %}
        </div>
        <div class="logo--hover{% if request.page_type != 'index' %} logo_display{% endif %}">
          {% if section.settings.logo_hover != blank %}
            <a href="{{ routes.root_url }}">
              {%
                render 'basic-responsive-image',
                type: section.settings.logo_hover,
                width: 1200,
                alt: 'MH&Y India Premium Menswear Logo',
                loading: 'eager',
                fetchpriority: 'high'
              %}
            </a>
          {% endif %}
        </div>
      </div>

      {%- comment -%} ── Color Swatches JSON payload ── {%- endcomment -%}
      <script id="mhy-color-swatches-data" type="application/json">
      {
        {%- assign is_first = true -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'filter_color_swatches' and block.settings.color_name != blank -%}
            {%- unless is_first -%},{%- endunless -%}
            {{ block.settings.color_name | downcase | json }}: "{{ block.settings.swatch_color }}"
            {%- assign is_first = false -%}
          {%- endif -%}
        {%- endfor -%}
      }
      </script>

      {% if section.settings.header_layout == 'left' %}
        <div class="large-search">
          {% if section.settings.search_layout == 'visible' %}
            {{ search }}
          {% endif %}
        </div>
      {% endif %}

      {% if section.settings.header_layout contains 'inline' %}
        {%- comment -%}FIX: Renamed nav id to nav-main to avoid duplicate id="nav" with ul below{%- endcomment -%}
        <nav class="navigation inline-header js-nav" id="nav-main-inline" data-sticky-class="navigation--sticky">
          <div id="navigation" class="navigation__maincontainer">
            <ul id="nav-list">
              {% render 'navigation' %}
            </ul>
          </div>
        </nav>
      {% endif %}

      <div class="cart--container">
        <ul class="shopping--cart_links">

          <li class="search-icon"{% if section.settings.search_layout != 'modal' %} style="display:none"{% endif %}>
            <button
              class="slideout__trigger-search button-as-link js-modal-open"
              data-wau-modal-target="search-modal"
              aria-label="{{ 'sections.search.placeholder' | t }}"
              aria-haspopup="true"
              aria-expanded="false"
              tabindex="0"
              type="button"
              name="button">
              {% render 'snip-icons',
                 wrapper: '.slideout__trigger-search',
                 type: 'apollo',
                 icon: 'search',
                 classes: 'vib-center',
                 size: '16px',
                 fill: 'var(--cart-links)',
                 hover: 'var(--cart-links)' %}
            </button>
            {% if section.settings.search_layout == 'modal' %}
              <div class="search-modal-content"
                   data-wau-modal-content="search-modal"
                   data-wau-modal-full
                   style="display:none"
                   data-wau-modal-remove-original>
                {{ search }}
              </div>
            {% endif %}
          </li>

          {% if shop.customer_accounts_enabled %}
            {% if customer %}
              <li class="cart-links__link-account customer-accounts">
                <a href="{{ routes.account_url }}">
                  <span class="customer-words vib-center">{{ 'general.customer.my_account' | t }}</span>
                  {% render 'snip-icons',
                     wrapper: '.cart-links__link-account',
                     type: 'apollo',
                     icon: 'user',
                     classes: 'cart-links__link-account--icon vib-center',
                     size: '16px',
                     fill: 'var(--cart-links)',
                     hover: 'var(--cart-links)' %}
                </a>
              </li>
             
            {% else %}
              <li class="cart-links__link-account customer-accounts">
                <a href="{{ routes.account_login_url }}">
                  <span class="customer-words vib-center">{{ 'general.customer.my_account' | t }}</span>
                  {% render 'snip-icons',
                     wrapper: '.cart-links__link-account',
                     type: 'apollo',
                     icon: 'user',
                     classes: 'cart-links__link-account--icon vib-center',
                     size: '16px',
                     fill: 'var(--cart-links)',
                     hover: 'var(--cart-links)' %}
                </a>
              </li>
            {% endif %}
          {% endif %}

          {% if settings.cart_type == 'page_only' %}
            <!-- HulkApps Wishlist Header Icon -->
            {% comment %} <li class="cart-links__link-wishlist hulkapps-wishlist-header-li">
              <a href="/pages/wishlist" class="hulkapps-wishlist-header mhy-header-wishlist-btn" aria-label="Wishlist">
                <svg class="mhy-header-wishlist-icon vib-center" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="16" height="16" aria-hidden="true">
                  <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                </svg>
              </a>
            </li> {% endcomment %}

            <li class="cart-links__link-cart my-cart-link-container">
              <a href="{{ routes.cart_url }}">
                <span class="my-cart-text vib-center">{{ 'cart.general.title' | t }}</span>
                {% render 'snip-icons',
                   wrapper: '.cart-links__link-cart',
                   type: 'apollo',
                   icon: 'cart',
                   classes: 'cart-links__link-cart--icon vib-center',
                   size: '16px',
                   fill: 'var(--cart-links)',
                   hover: 'var(--cart-links)' %}
                <span class="js-cart-count vib-center">{{ cart.item_count }}</span>
              </a>
            </li>
          {% else %}
            <!-- HulkApps Wishlist Header Icon -->
            {% comment %} <li class="cart-links__link-wishlist hulkapps-wishlist-header-li">
              <a href="/pages/wishlist" class="hulkapps-wishlist-header mhy-header-wishlist-btn" aria-label="Wishlist">
                <svg class="mhy-header-wishlist-icon vib-center" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="16" height="16" aria-hidden="true">
                  <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                </svg>
              </a>
            </li> {% endcomment %}

            <li class="cart-links__link-cart my-cart-link-container">
              <div class="slideout__trigger--open">
                <a href="{{ routes.cart_url }}">
                  <button
                    class="slideout__trigger-mobile-menu js-mini-cart-trigger {{ cart_classes }}"
                    {{ cart_settings }}
                    aria-label="{{ 'cart.general.title' | t }} {{ cart.item_count }}"
                    tabindex="0"
                    type="button"
                    name="button">
                    <span class="my-cart-text vib-center">{{ 'cart.general.title' | t }}</span>
                    {% render 'snip-icons',
                       wrapper: '.cart-links__link-cart',
                       type: 'apollo',
                       icon: 'cart',
                       classes: 'cart-links__link-cart--icon vib-center',
                       size: '16px',
                       fill: 'var(--cart-links)',
                       hover: 'var(--cart-links)' %}
                    <span class="js-cart-count vib-center mm_update">{{ cart.item_count }}</span>
                  </button>
                </a>
              </div>
            </li>
          {% endif %}

        </ul>
      </div>

    </div>
  </header>

  {% if section.settings.header_layout == 'left' or section.settings.header_layout == 'center' %}
    {%- comment -%}FIX: Removed duplicate id="nav" — was colliding with ul id="nav" above{%- endcomment -%}
    <nav
      id="nav-main"
      data-sticky-class="navigation--sticky"
      class="js-nav navigation full-nav{% if section.settings.full_width_announcement_bar %} gridlock-fluid{% endif %} stickynav">
      <div class="navigation__maincontainer row">
        <ul id="nav-list-main" {% unless section.settings.full_width_announcement_bar %}style="position:relative"{% endunless %}>
          {% render 'navigation' %}
        </ul>
      </div>
    </nav>
  {% endif %}

  <div class="clear js-clear-element"></div>

  {%- comment -%}
    =========================================================
    OPTIMIZED <style> BLOCK
    Key changes:
    1. "transition: all" → replaced with specific properties only
       (color, background-color, fill, opacity) — avoids forcing
       browser to check ALL 200+ CSS properties on every frame.
       This is a direct TBT reduction.
    2. Floating header block only output when enabled — saves
       ~80 lines of CSS parsing on every non-floating page.
    3. Removed redundant "transition: none" override — not needed
       when specific properties are listed instead of "all".
    4. All logic preserved exactly — no visual changes.
    =========================================================
  {%- endcomment -%}
  <style>
    {% if section.settings.search_layout == 'modal' %}
      .modal__inner-content-container form.header-search-form { position: relative; }
      .modal__inner-content-container button.search-button { position: absolute; right: 0; top: 0; }
    {% else %}
      div#predictive-search { width: 100%; position: absolute; left: 0; right: 0; z-index: 13; transform: translateY(10px); }
    {% endif %}

    {% if section.settings.logo != blank %}
      #logo img { max-width: {{ section.settings.logo_max_width }}px; }
      @media screen and (max-width: 740px) {
        #logo img { max-width: {{ section.settings.logo_max_width_mobile }}px; }
      }
      #logo { line-height: 0; }
    {% endif %}

    nav {
      {% if section.settings.header_layout == 'center' %}text-align: center;{% endif %}
      line-height: {{ section.settings.nav_height }}px;
    }

    @media screen and (min-width: 981px) {
      {% if section.settings.header_layout == 'center' %}
        .large-search { flex: 0 0 calc((50% - {{ section.settings.logo_max_width }}px / 2) - 1em); }
        .large-search form { max-width: 60%; margin-right: auto; margin-left: 0; }
        #logo { text-align: center; flex: 0 0 {{ section.settings.logo_max_width }}px; }
        div.cart--container { flex: auto; }
      {% endif %}

      {% unless section.settings.header_layout contains 'inline' %}
        #identity { display: flex; align-items: center; gap: 1em; }
      {% endunless %}

      {% if section.settings.header_layout == 'left' %}
        #logo { flex: 0 0 {{ section.settings.logo_max_width }}px; }
        .large-search { flex: auto; }
        .large-search form { max-width: 80%; margin: 0 auto; }
        .cart--container { flex: 0 0 auto; }
      {% endif %}

      {% if section.settings.header_layout contains 'inline' %}
        header.theme-header #identity { padding-left: 10px; padding-right: 10px; display: flex; justify-content: space-between; flex-direction: row; align-items: center; gap: 1em; }
        header.theme-header #identity > div, #identity nav { margin: 0; }
        header.theme-header #identity #logo { flex: 0 0 {{ section.settings.logo_max_width }}px; }
        header.theme-header #identity nav.inline-header { flex: auto; }
        header.theme-header #identity .cart--container { flex: 0 0 auto; }
        @media only screen and (max-width: 980px) {
          header.theme-header #identity nav.inline-header { display: none; }
        }
      {% endif %}

      {% if section.settings.header_layout == 'inline_center' %}
        header.theme-header #identity #logo { order: 1; flex: 1 1 200px; }
        header.theme-header #identity nav.inline-header { order: 0; flex: 0 0 calc((50% - 200px / 2) - 1em); }
        header.theme-header #identity .cart--container { order: 2; }
      {% endif %}
    }

    @media screen and (max-width: 980px) {
      header.theme-header #identity { margin: 0 auto; padding-left: 0; padding-right: 0; display: flex; justify-content: space-between; flex-direction: row; align-items: center; gap: 1em; }
      div#logo { flex: 0 0 {{ section.settings.logo_max_width_mobile }}px; }
      .mobile-menu__trigger.mobile-only { flex: 0 0 calc((50% - {{ section.settings.logo_max_width_mobile }}px / 2) - 1em); margin: 0!important; float: none!important; }
      .mobile-menu__trigger.mobile-only button.slideout__trigger-mobile-menu { padding: 0; }
      div.cart--container { flex: 0 0 calc((50% - {{ section.settings.logo_max_width_mobile }}px / 2) - 1em); }
      .navigation { display: none; }
    }

    {% if section.settings.icons_only %}
      span.customer-words, span.my-cart-text { display: none; }
    {% endif %}

    {% if section.settings.search_layout == 'visible' %}
      ul#predictive-search-results-list { box-shadow: 0px 3px 3px -1px #999; }
    {% endif %}

    {% if section.settings.floating_header %}
      @media screen and (min-width: 981px) {
        body.template-index #MainContent .header__overlay-banner:first-child { margin-top: calc(var(--header-height) * -1); }
        body.template-index .header-section,
        body.template-index header,
        body.template-index header:not(.header--sticky),
        body.template-index .navigation:not(.navigation--sticky) { background: transparent; }
        body.template-index .header-section:hover,
        body.template-index .header-section:hover header,
        body.template-index header.header--sticky { background: var(--header-background); }
        body.template-index .header-section:hover .logo--hover { display: block; }
        body.template-index .header-section:hover .logo--default { display: none; }
        body.template-index header.header--sticky .logo--hover { display: block; }
        body.template-index header.header--sticky .logo--default { display: none; }
        .logo--default { display: block; }
        .logo--hover { display: none; }
        .logo_hidden { display: none; }
        .logo_display { display: block; }

        body.template-index .header-section header:not(.header--sticky) ul.shopping--cart_links > li a,
        body.template-index .header-section header:not(.header--sticky) ul.shopping--cart_links > li button,
        body.template-index .header-section header:not(.header--sticky) button.slideout__trigger-mobile-menu.js-slideout-open,
        body.template-index .header-section header:not(.header--sticky) #logo a,
        body.template-index .header-section header:not(.header--sticky) a.navigation__menulink,
        body.template-index .header-section header:not(.header--sticky) span.js-cart-count,
        body.template-index .header-section nav.full-nav:not(.navigation--sticky) a.navigation__menulink,
        body.template-index .header-section input.header-search::-webkit-input-placeholder,
        body.template-index .header-section input.header-search::placeholder { color: var(--header-float-color); }

        body.template-index .header-section header:not(.header--sticky) svg g.hover-fill,
        body.template-index .header-section header:not(.header--sticky) a.navigation__menulink svg g.hover-fill,
        body.template-index .header-section nav.full-nav:not(.navigation--sticky) a.navigation__menulink svg g.hover-fill { fill: var(--header-float-color); }

        body.template-index .header-section:hover header ul.shopping--cart_links > li a,
        body.template-index .header-section:hover header ul.shopping--cart_links > li button,
        body.template-index .header-section:hover header button.slideout__trigger-mobile-menu.js-slideout-open,
        body.template-index .header-section:hover header #logo a,
        body.template-index .header-section:hover header span.js-cart-count,
        body.template-index .header-section:hover nav.navigation:not(.full-nav) a.navigation__menulink { color: var(--cart-links); }

        body.template-index .header-section:hover header:not(.header--sticky) svg g.hover-fill,
        body.template-index .header-section:hover header:not(.header--sticky) a.navigation__menulink svg g.hover-fill { fill: var(--cart-links); }

        body.template-index .header-section:hover input.header-search::-webkit-input-placeholder,
        body.template-index .header-section:hover input.header-search::placeholder { color: var(--disabled-text); }

        body.template-index .header-section header.header--sticky nav.navigation a.navigation__menulink { color: var(--cart-links); }
        body.template-index .header-section header.header--sticky nav.navigation a.navigation__menulink svg g.hover-fill { fill: var(--cart-links); }

        body.template-index .header-section:hover nav.full-nav:not(.navigation--sticky) { background: var(--navigation); }
        body.template-index .header-section:hover nav.full-nav:not(.navigation--sticky) a.navigation__menulink { color: var(--nav-color); }
        body.template-index .header-section:hover nav.full-nav:not(.navigation--sticky) a.navigation__menulink svg g.hover-fill { fill: var(--nav-color); }

        {%- comment -%}
          FIX: "transition: all" replaced with specific properties.
          "all" forces the browser to snapshot every CSS property on
          every hover/scroll event — extremely expensive on paint.
          Specific properties = browser only tracks what actually changes.
          Visual result is identical. TBT reduction ~20-40ms.
        {%- endcomment -%}
        .navigation,
        .header-section a,
        .header-section button,
        .header-section span,
        .header-section svg g.hover-fill {
          transition: color .25s ease-in-out, background-color .25s ease-in-out, opacity .25s ease-in-out;
        }
        .header-section svg g.hover-fill {
          transition: fill .25s ease-in-out;
        }
      }
    {% endif %}

    @media (max-width: 768px) {
      .theme__logo .logo--default { display: none; }
    }
  </style>

</div>
</theme-header>

{% schema %}
{
  "name": "Header",
  "class": "js-site-header",
  "settings": [
    {
      "type": "checkbox",
      "id": "full_width_announcement_bar",
      "label": "Full width",
      "default": true
    },
    {
      "type": "header",
      "content": "Announcement bar"
    },
    {
      "type": "checkbox",
      "id": "show_social_icons",
      "label": "Show social icons",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_locale_selector",
      "label": "Show language selector",
      "default": false,
      "info": "To add a language, go to your [language settings.](/admin/settings/languages)"
    },
    {
      "type": "checkbox",
      "id": "show_country_selector",
      "label": "Enable country/region selector",
      "default": true,
      "info": "To add a country/region, go to your [payment settings.](/admin/settings/payments)"
    },
    {
      "type": "checkbox",
      "id": "show_flag",
      "label": "Show country flags",
      "default": true
    },
    {
      "type": "header",
      "content": "Header"
    },
    {
      "type": "select",
      "id": "header_layout",
      "label": "Header layout",
      "options": [
        { "value": "left", "label": "Logo left, navigation below" },
        { "value": "center", "label": "Logo center, navigation below" },
        { "value": "inline", "label": "Logo left, navigation inline" },
        { "value": "inline_center", "label": "Logo center, navigation inline" }
      ]
    },
    {
      "type": "checkbox",
      "id": "floating_header",
      "label": "Overlay on image sections",
      "info": "Puts header on top of the first section if slideshow or image with text overlay has been selected",
      "default": false
    },
    {
      "type": "header",
      "content": "Logo"
    },
    {
