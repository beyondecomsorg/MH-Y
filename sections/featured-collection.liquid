{% style %}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.desktop_padding_top }}px !important;
    padding-bottom: {{ section.settings.desktop_padding_bottom }}px !important;
  }
  @media screen and (max-width: 740px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.mobile_padding_top }}px !important;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px !important;
    }
  }
{% endstyle %}

{%- liquid

  assign collection = collections[section.settings.collection]

  if section.settings.carousel
    assign is_carousel = true
  endif

  assign prod_limit = section.settings.limit
  assign grid = section.settings.grid

  assign enough_to_wrap = true

  assign section_padding = ''
  if section.settings.section_padding == 'top'
    assign section_padding = 'pb0'
  elsif section.settings.section_padding == 'bottom'
    assign section_padding = 'mt0'
  elsif section.settings.section_padding == 'none'
    assign section_padding = 'mt0 pb0'
  endif

  case grid
    when 2
    assign prod_grid = 50
    when 3
    assign prod_grid = 33.333
    when 4
    assign prod_grid = 25
    when 5
    assign prod_grid = 20
  endcase

  assign aos_mod = section.settings.grid | plus: 0

-%}

<section class="global__section {{ section_padding }}" data-section-id="{{ section.id }}" data-section-type="featured-collection" data-aos="fade">
  <div class="row grid__wrapper gr0">
    {% if section.settings.heading != blank %}
      <div class="span-12 auto">
        <h2 class="section-heading mb0">
          <a href="{{ collection.url }}">{{ section.settings.heading | escape }}</a>
        </h2>
      </div>
    {% endif %}

    <!-- Splide assets loaded conditionally for Featured Collection Carousel -->
    {% if is_carousel %}
      <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@splidejs/splide@4.1.4/dist/css/splide.min.css">
      <script src="https://cdn.jsdelivr.net/npm/@splidejs/splide@4.1.4/dist/js/splide.min.js"></script>
    {% endif %}

    {% if is_carousel %}
      <!-- SPLIDE CAROUSEL STRUCTURE -->
      <div id="featured_collection--{{ section.id }}" class="splide featured__collection-carousel product-loop span-12 auto" data-product-count="{{ collection.products.size }}">
        <div class="splide__track">
          <ul class="splide__list">
            {% if section.settings.collection == blank %}
              {% comment %}
                Render onboard mockup products wrapped in splide__slide
              {% endcomment %}
              {% for i in (1..prod_limit) %}
                {% capture current %}{% cycle 1, 2, 3, 4, 5 %}{% endcapture %}
                {%- assign placeholder = 'product-' | append: current -%}
                <li class="splide__slide aaaaa featured__collection-product product-index" data-aos="fade" data-aos-delay="{{ forloop.index | minus: 1 | modulo: aos_mod | times: 100 }}">
                  <div class="onboard">
                    {{ placeholder | placeholder_svg_tag: 'placeholder-svg' }}
                  </div>
                </li>
              {% endfor %}
            {% else %}
              {% for product in collection.products limit: prod_limit %}
                <li class="splide__slide aaaaa featured__collection-product product-index js-product-listing" 
                  id="product-listing-{{ product.id }}" 
                  data-product-id="{{ product.id }}" 
                  data-alpha="{{ product.title }}" 
                  data-price="{{ product.price }}"
                  data-aos="fade"
                  data-aos-delay="{{ forloop.index | minus: 1 | modulo: aos_mod | times: 100 }}">
                  {% liquid
                    assign loading = 'lazy'
                    assign fetch_priority = 'auto'
                    if section.index == 1 and forloop.index <= grid
                      assign loading = 'eager'
                      assign fetch_priority = 'high'
                    endif
                  %}
                  {% render 'product-listing', product: product, collection: collection, loading: loading, fetchpriority: fetch_priority, index: forloop.index %}
                </li>
              {% endfor %}
            {% endif %}
          </ul>
        </div>
      </div>
    {% else %}
      <!-- ORIGINAL DYNAMIC GRID STRUCTURE (No Carousel) -->
      <div id="featured_collection--{{ section.id }}" class="featured__collection product-loop span-12 auto" data-product-count="{{ collection.products.size }}">
        {% if section.settings.collection == blank %}
          {% render 'onboard-product', prod_limit: prod_limit, grid: grid, aos_mod: aos_mod %}
        {% else %}
          {% for product in collection.products limit: prod_limit %}
            <div class="aaaaa featured__collection-product product-index js-product-listing" 
              id="product-listing-{{ product.id }}" 
              data-product-id="{{ product.id }}" 
              data-alpha="{{ product.title }}" 
              data-price="{{ product.price }}"
              data-aos="fade"
              data-aos-delay="{{ forloop.index | minus: 1 | modulo: aos_mod | times: 100 }}">
              {% liquid
                assign loading = 'lazy'
                assign fetch_priority = 'auto'
                if section.index == 1 and forloop.index <= grid
                  assign loading = 'eager'
                  assign fetch_priority = 'high'
                endif
              %}
              {% render 'product-listing', product: product, collection: collection, loading: loading, fetchpriority: fetch_priority, index: forloop.index %}
            </div>
          {% endfor %}
        {% endif %}
      </div>
    {% endif %}

    {% if section.settings.show_view_all %}
      <div class="featured__collection-button-container span-12 auto">
        <a class="button featured__collection-view-all-button" href="{{ collection.url }}">
          {{ 'sections.featured_collection.view_all' | t }}
        </a>
      </div>
    {% endif %}
  </div>

  {% if is_carousel %}
    <script>
      (function() {
        var sectionId = "{{ section.id }}";
        var carouselId = "featured_collection--" + sectionId;

        var baseOptions = {
          type: 'slide',
          perPage: {{ grid }},
          perMove: 1,
          gap: '24px',
          pagination: false,
          arrows: true,
          drag: true,
          snap: true,
          waitForTransition: false,
          breakpoints: {
            1024: { perPage: 3, gap: '20px' },
            768:  { perPage: 2, gap: '12px' },
            480:  { perPage: 1.5, gap: '10px' }
          }
        };

        function attachSwipeFallback(el, splide) {
          // Some other script on the page (a quick-add/hover handler on a
          // child element inside the cards) is calling stopPropagation()
          // on touchstart/mousedown before it reaches Splide's own drag
          // listener. Capture-phase listeners run BEFORE any bubble-phase
          // stopPropagation can block them, so we track the gesture here
          // independently and only step the slide ourselves if Splide's
          // own handling did not already move it.
          var track = el.querySelector('.splide__track') || el;
          var startX = 0, startY = 0, startIndex = 0, active = false;

          function down(x, y) {
            active = true;
            startX = x;
            startY = y;
            startIndex = splide.index;
          }

          function up(x, y) {
            if (!active) return;
            active = false;
            var deltaX = x - startX;
            var deltaY = y - startY;

            // Ignore mostly-vertical gestures (page scroll)
            if (Math.abs(deltaX) < 40 || Math.abs(deltaX) < Math.abs(deltaY)) return;

            // Wait one tick so Splide's own (bubble-phase) drag handler,
            // if it fired, has already updated splide.index first.
            setTimeout(function() {
              if (splide.index !== startIndex) return; // native drag already handled it
              if (deltaX < 0) {
                splide.go('>');
              } else {
                splide.go('<');
              }
            }, 0);
          }

          track.addEventListener('touchstart', function(e) {
            var t = e.touches[0];
            down(t.clientX, t.clientY);
          }, { capture: true, passive: true });

          track.addEventListener('touchend', function(e) {
            var t = e.changedTouches[0];
            up(t.clientX, t.clientY);
          }, { capture: true, passive: true });

          track.addEventListener('mousedown', function(e) {
            down(e.clientX, e.clientY);
          }, { capture: true });

          track.addEventListener('mouseup', function(e) {
            up(e.clientX, e.clientY);
          }, { capture: true });
        }

        function initSplide() {
          var el = document.getElementById(carouselId);
          if (!el || typeof Splide === 'undefined') return;

          // Prevent duplicate instances — this is what silently breaks drag
          if (el.splideInstance) {
            el.splideInstance.destroy(true);
            el.splideInstance = null;
          }

          var splide = new Splide(el, baseOptions);
          splide.mount();
          el.splideInstance = splide;
          attachSwipeFallback(el, splide);
        }

        document.addEventListener("DOMContentLoaded", initSplide);

        document.addEventListener("shopify:section:load", function(event) {
          if (event.target.id === "shopify-section-" + sectionId) {
            initSplide();
          }
        });

        document.addEventListener("shopify:section:unload", function(event) {
          if (event.target.id === "shopify-section-" + sectionId) {
            var el = document.getElementById(carouselId);
            if (el && el.splideInstance) {
              el.splideInstance.destroy(true);
              el.splideInstance = null;
            }
          }
        });
      })();
    </script>
  {% endif %}

  <style>
    {% if section.settings.reduce_width %}
      @media screen and (min-width: 741px) {
        #featured_collection--{{ section.id }} {
          width: 80%;
          margin-left: auto;
          margin-right: auto;
        }
      }
    {% endif %}
    {% if is_carousel %}
      #featured_collection--{{ section.id }}.splide {
        padding: 0 0px !important;
        box-sizing: border-box !important;
      }

      /* THE ACTUAL FIX: tell the browser this track is horizontally
         drag-driven by JS, while still allowing native vertical page
         scroll to pass through untouched. Without this, mobile Safari/
         Chrome intercept the horizontal touch gesture as page-scroll
         hesitation before Splide's own touch handler ever fires. */
      #featured_collection--{{ section.id }} .splide__track {
        touch-action: pan-y !important;
      }
      #featured_collection--{{ section.id }} .splide__list {
        touch-action: pan-y !important;
      }

      /* Prevent text/image selection from hijacking the drag gesture
         mid-swipe (long-press-to-select on mobile competes with drag) */
      #featured_collection--{{ section.id }} .splide__slide {
        -webkit-user-select: none !important;
        -moz-user-select: none !important;
        user-select: none !important;
        -webkit-touch-callout: none !important;
      }

      #featured_collection--{{ section.id }} .splide__arrows {
        pointer-events: none !important;
      }
      #featured_collection--{{ section.id }} .splide__arrow {
        background: #173250 !important;
        color: #ffffff !important;
        width: 40px !important;
        height: 40px !important;
        opacity: 0.9 !important;
        pointer-events: auto !important;
      }
      #featured_collection--{{ section.id }} .splide__arrow svg {
        fill: currentColor !important;
        width: 14px !important;
        height: 14px !important;
      }
      #featured_collection--{{ section.id }} .splide__arrow:hover {
        background: #805c42 !important;
      }
      #featured_collection--{{ section.id }} .splide__arrow--prev {
        left: -10px !important;
      }
      #featured_collection--{{ section.id }} .splide__arrow--next {
        right: -10px !important;
      }
      #featured_collection--{{ section.id }} img,
      #featured_collection--{{ section.id }} a {
        -webkit-user-drag: none !important;
        -khtml-user-drag: none !important;
        -moz-user-drag: none !important;
        -o-user-drag: none !important;
        user-drag: none !important;
      }
    {% else %}
      #featured_collection--{{ section.id }}.featured__collection {
        display: grid;
        grid-template-columns: repeat({{ grid }}, 1fr);
      }
    {% endif %}
  </style>
</section>
<div class="clear"></div>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    {
      "type": "range",
      "id": "desktop_padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Section Top Padding (Desktop)",
      "default": 30
    },
    {
      "type": "range",
      "id": "desktop_padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Section Bottom Padding (Desktop)",
      "default": 30
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Section Top Padding (Mobile)",
      "default": 15
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Section Bottom Padding (Mobile)",
      "default": 15
    },{
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured collection"
    },
    {
      "id": "collection",
      "type": "collection",
      "label": "Collection"
    },
    {
      "id": "carousel",
      "type": "checkbox",
      "label": "Display in carousel"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show view all button"
    },
    {
      "type": "checkbox",
      "id": "reduce_width",
      "label": "Reduce section width",
      "info": "80% width on non mobile devices"
    },
    {
      "type": "range",
      "id": "grid",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "Product grid",
      "default": 4
    },
    {
      "type": "range",
      "id": "limit",
      "min": 2,
      "max": 20,
      "step": 1,
      "label": "Products shown",
      "default": 12
    },
    {
      "type": "select",
      "id": "section_padding",
      "label": "Section spacing",
      "options": [
        {
          "value": "top",
          "label": "Top"
        },
        {
          "value": "bottom",
          "label": "Bottom"
        },
        {
          "value": "both",
          "label": "Both"
        },
        {
          "value": "none",
          "label": "None"
        }
      ],
      "default": "both"
    }
  ],
  "presets": [{
    "name": "Featured collection"
  }],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
