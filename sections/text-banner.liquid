<section class="section-{{ section.id }} usp__section {{ section.settings.custom_class }}" data-section-id="{{ section.id }}" data-aos="fade">

  {% if section.blocks.size > 0 %}
    <div class="usp__marquee-wrapper">
      <div class="usp__marquee-track">
        
        {%- comment -%} Group 1 {%- endcomment -%}
        <div class="usp__marquee-content">
          {% for block in section.blocks %}
            <div class="usp__content usp-{{ block.id }}">
              {%- if block.settings.image != blank -%}
                {%- assign img_height = 40 | times: block.settings.image.height | divided_by: block.settings.image.width -%}
                {{ block.settings.image | image_url: width: 40 | image_tag: class: 'textcol-image', loading: 'lazy', alt: block.settings.image_alt, width: 40, height: img_height }}
              {%- endif -%}
              <div class="usp__text-group">
                <h3>{{ block.settings.heading | escape }}</h3>
                <div class="usp__textarea">{{ block.settings.textarea }}</div>
              </div>
            </div>
          {% endfor %}
        </div>

        {%- comment -%} Group 2 (Duplicated for seamless looping) {%- endcomment -%}
        <div class="usp__marquee-content" aria-hidden="true">
          {% for block in section.blocks %}
            <div class="usp__content usp-{{ block.id }}">
              {%- if block.settings.image != blank -%}
                {%- assign img_height = 40 | times: block.settings.image.height | divided_by: block.settings.image.width -%}
                {{ block.settings.image | image_url: width: 40 | image_tag: class: 'textcol-image', loading: 'lazy', alt: block.settings.image_alt, width: 40, height: img_height }}
              {%- endif -%}
              <div class="usp__text-group">
                <h3>{{ block.settings.heading | escape }}</h3>
                <div class="usp__textarea">{{ block.settings.textarea }}</div>
              </div>
            </div>
          {% endfor %}
        </div>

        {%- comment -%} Group 3 (Duplicated for seamless looping on ultra-wide screens) {%- endcomment -%}
        <div class="usp__marquee-content" aria-hidden="true">
          {% for block in section.blocks %}
            <div class="usp__content usp-{{ block.id }}">
              {%- if block.settings.image != blank -%}
                {%- assign img_height = 40 | times: block.settings.image.height | divided_by: block.settings.image.width -%}
                {{ block.settings.image | image_url: width: 40 | image_tag: class: 'textcol-image', loading: 'lazy', alt: block.settings.image_alt, width: 40, height: img_height }}
              {%- endif -%}
              <div class="usp__text-group">
                <h3>{{ block.settings.heading | escape }}</h3>
                <div class="usp__textarea">{{ block.settings.textarea }}</div>
              </div>
            </div>
          {% endfor %}
        </div>

      </div>
    </div>
  {% else %}
    {% render 'no-blocks' %}
  {% endif %}

  <style>
    .section-{{ section.id }} {
      {% if section.settings.section_padding == 'top' %}
        margin-top: calc(var(--section-padding) / 2);
      {% elsif section.settings.section_padding == 'bottom' %}
        margin-bottom: calc(var(--section-padding) / 2);
      {% elsif section.settings.section_padding == 'none' %}
        margin-top: 0 !important;
        margin-bottom: 0 !important;
      {% elsif section.settings.section_padding == 'both' %}
        margin-top: calc(var(--section-padding) / 2);
        margin-bottom: calc(var(--section-padding) / 2);
      {% endif %}
    }
    .section-{{ section.id }}.usp__section {
      background: {{ section.settings.background }};
      padding: {{ section.settings.vertical_spacing }}px 0 !important;
      overflow: hidden;
      width: 100%;
    }
    .section-{{ section.id }} .usp__marquee-wrapper {
      width: 100%;
      overflow: hidden;
      position: relative;
    }
    .section-{{ section.id }} .usp__marquee-track {
      display: flex;
      width: max-content;
      align-items: center;
      user-select: none;
    }
    .section-{{ section.id }} .usp__marquee-content {
      display: flex;
      flex-shrink: 0;
      align-items: center;
      gap: {{ section.settings.spacing | times: 3 | plus: 40 }}px;
      padding-right: {{ section.settings.spacing | times: 3 | plus: 40 }}px;
    }
    
    /* Desktop css animation */
    @media screen and (min-width: 741px) {
      .section-{{ section.id }} .usp__marquee-content {
        animation: scroll-marquee-{{ section.id }} 25s linear infinite;
      }
      .section-{{ section.id }} .usp__marquee-track:hover .usp__marquee-content {
        animation-play-state: paused;
      }
    }

    .section-{{ section.id }} .usp__content {
      display: flex;
      align-items: center;
      gap: 12px;
      flex-shrink: 0;
    }
    .section-{{ section.id }} .usp__content .textcol-image {
      width: 32px;
      height: auto;
      object-fit: contain;
      display: block;
    }
    .section-{{ section.id }} .usp__text-group {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      justify-content: center;
      text-align: left;
    }
    .section-{{ section.id }}.usp__section .usp__content h3 {
      font-size: {{ section.settings.notification_heading_size }}px;
      font-weight: 700;
      letter-spacing: 0.05em;
      margin: 0;
      line-height: 1.2;
    }
    .section-{{ section.id }}.usp__section .usp__content .usp__textarea p,
    .section-{{ section.id }}.usp__section .usp__content .usp__textarea {
      font-size: {{ section.settings.notification_font_size }}px;
      margin: 2px 0 0 0;
      line-height: 1.3;
    }
    .section-{{ section.id }} .usp__content h3,
    .section-{{ section.id }} .usp__content .usp__textarea,
    .section-{{ section.id }} .usp__content a,
    .section-{{ section.id }} .usp__content a:visited {
      color: {{ section.settings.text_color }};
    }

    /* Divider styling between items */
    {% if section.settings.add_divider %}
      .section-{{ section.id }} .usp__content {
        position: relative;
      }
      .section-{{ section.id }} .usp__content::after {
        content: "";
        display: block;
        width: 1px;
        height: 24px;
        background: {{ section.settings.text_color }};
        opacity: 0.3;
        margin-left: {{ section.settings.spacing | times: 1.5 | plus: 20 }}px;
      }
    {% endif %}

    @keyframes scroll-marquee-{{ section.id }} {
      0% {
        transform: translate3d(0, 0, 0);
      }
      100% {
        transform: translate3d(-100%, 0, 0);
      }
    }

    /* Mobile marquee styles */
    @media screen and (max-width: 740px) {
      .section-{{ section.id }} .usp__marquee-wrapper {
        overflow-x: auto !important;
        -webkit-overflow-scrolling: touch !important;
        scrollbar-width: none !important;
      }
      .section-{{ section.id }} .usp__marquee-wrapper::-webkit-scrollbar {
        display: none !important;
      }
      .section-{{ section.id }} .usp__marquee-wrapper.is-snapping {
        scroll-snap-type: x mandatory !important;
      }
      .section-{{ section.id }} .usp__marquee-wrapper.is-snapping .usp__content {
        scroll-snap-align: start !important;
      }
      .section-{{ section.id }} .usp__content {
        width: 77vw !important;
      }
      .section-{{ section.id }} .usp__marquee-content {
        gap: 24px !important;
        padding-right: 24px !important;
      }
      {% if section.settings.add_divider %}
        .section-{{ section.id }} .usp__content::after {
          margin-left: 12px !important;
        }
      {% endif %}
      .section-{{ section.id }}.usp__section .usp__content h3 {
        font-size: calc({{ section.settings.notification_heading_size }}px * 0.85);
      }
      .section-{{ section.id }}.usp__section .usp__content .usp__textarea p,
      .section-{{ section.id }}.usp__section .usp__content .usp__textarea {
        font-size: calc({{ section.settings.notification_font_size }}px * 0.85);
      }
      .section-{{ section.id }} .usp__content .textcol-image {
        width: 28px;
      }
    }

    /* Accessibility prefers-reduced-motion */
    @media (prefers-reduced-motion: reduce) {
      .section-{{ section.id }} .usp__marquee-content {
        animation: none !important;
      }
    }
  </style>

  <script>
    (function() {
      const wrapper = document.querySelector('.section-{{ section.id }} .usp__marquee-wrapper');
      if (!wrapper) return;
      const track = wrapper.querySelector('.usp__marquee-track');
      if (!track) return;

      let isMobile = window.innerWidth <= 740;
      let autoScroll = true;
      const scrollSpeed = 0.5; // pixels per frame
      let scrollTimeout = null;

      function checkMode() {
        isMobile = window.innerWidth <= 740;
        if (!isMobile) {
          wrapper.classList.remove('is-snapping');
        }
      }
      window.addEventListener('resize', checkMode);
      checkMode();

      let lastTime = performance.now();
      function updateScroll(timestamp) {
        const delta = timestamp - lastTime;
        lastTime = timestamp;

        if (autoScroll && isMobile) {
          const firstGroup = track.querySelector('.usp__marquee-content');
          if (firstGroup) {
            const groupWidth = firstGroup.offsetWidth;
            wrapper.scrollLeft += scrollSpeed * (delta / 16.67);
            
            if (wrapper.scrollLeft >= groupWidth) {
              wrapper.scrollLeft -= groupWidth;
            }
          }
        }
        requestAnimationFrame(updateScroll);
      }
      requestAnimationFrame(updateScroll);

      wrapper.addEventListener('touchstart', function() {
        autoScroll = false;
        wrapper.classList.add('is-snapping');
        if (scrollTimeout) clearTimeout(scrollTimeout);
      }, { passive: true });

      wrapper.addEventListener('touchend', function() {
        if (scrollTimeout) clearTimeout(scrollTimeout);
        scrollTimeout = setTimeout(function() {
          wrapper.classList.remove('is-snapping');
          autoScroll = true;
        }, 2000);
      }, { passive: true });
    })();
  </script>

</section>

{% schema %}
{
  "name": "Text banner",
  "max_blocks": 3,
  "settings": [{
      "type": "range",
      "id": "notification_heading_size",
      "min": 13,
      "max": 36,
      "step": 1,
      "unit": "px",
      "label": "Heading size",
      "default": 22
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "Custom CSS Class"
    },
    {
      "type": "range",
      "id": "notification_font_size",
      "min": 13,
      "max": 22,
      "step": 1,
      "unit": "px",
      "label": "Text size",
      "default": 14
    },
    {
      "type": "range",
      "id": "vertical_spacing",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "px",
      "label": "Vertical padding",
      "default": 30
    },
    {
      "type": "range",
      "id": "spacing",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Space between columns",
      "default": 20
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#444444"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "checkbox",
      "id": "add_divider",
      "label": "Add divider between columns",
      "default": true
    },
    {
      "type": "select",
      "id": "section_padding",
      "label": "Section spacing",
      "options": [
        {
          "value": "top",
          "label": "Top"
        },
        {
          "value": "bottom",
          "label": "Bottom"
        },
        {
          "value": "both",
          "label": "Both"
        },
        {
          "value": "none",
          "label": "None"
        }
      ],
      "default": "both"
    }
  ],
  "blocks": [{
    "type": "text",
    "name": "Text",
    "settings": [{
        "id": "heading",
        "type": "text",
        "label": "Heading",
        "default": "Promotion title"
      },
      {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Image Alt Text"
        },
      {
        "id": "textarea",
        "type": "richtext",
        "label": "Text",
        "default": "<p>Add promotional content to a text banner</p>"
      }
    ]
  }],
  "presets": [{
    "name": "Text banner",
    "blocks": [{
        "type": "text"
      },
      {
        "type": "text"
      },
      {
        "type": "text"
      }
    ]
  }],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
