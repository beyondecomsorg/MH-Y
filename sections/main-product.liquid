<script>
  document.addEventListener('DOMContentLoaded', function() {
    var shareModal = document.getElementById('pdpShareModal-{{ section.id }}');
    var triggers = document.querySelectorAll('.js-pdp-share-trigger');
    var closeBtn = shareModal.querySelector('.js-pdp-share-modal-close');
    var copyBtn = shareModal.querySelector('.js-pdp-copy-link');
    var successMsg = shareModal.querySelector('.js-pdp-share-success-msg');

    function openModal() {
      shareModal.removeAttribute('hidden');
      document.body.style.overflow = 'hidden';
    }

    function closeModal() {
      shareModal.setAttribute('hidden', '');
      document.body.style.overflow = '';
      if (successMsg) successMsg.setAttribute('hidden', '');
    }

    triggers.forEach(function(trigger) {
      trigger.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        openModal();
      });
    });

    if (closeBtn) {
      closeBtn.addEventListener('click', closeModal);
    }

    shareModal.addEventListener('click', function(e) {
      if (e.target === shareModal) {
        closeModal();
      }
    });

    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && !shareModal.hasAttribute('hidden')) {
        closeModal();
      }
    });

    if (copyBtn) {
      copyBtn.addEventListener('click', function(e) {
        e.preventDefault();
        var urlToCopy = copyBtn.getAttribute('data-share-url') || window.location.href;
        navigator.clipboard.writeText(urlToCopy).then(function() {
          if (successMsg) {
            successMsg.removeAttribute('hidden');
            setTimeout(function() {
              successMsg.setAttribute('hidden', '');
            }, 3000);
          }
        }).catch(function(err) {
          console.error('Could not copy link: ', err);
        });
      });
    }
  });
</script>
