                    {%- style -%}
                      #pdp-image-block-{{ block.id }} .product__info-image-el {
                        width: 100% !important;
                        max-width: {{ width_style }} !important;
                        height: auto !important;
                        display: inline-block !important;
                        border-radius: {{ block.settings.border_radius }}px !important;
                      }
                      @media screen and (max-width: 768px) {
                        #pdp-image-block-{{ block.id }} .product__info-image-el {
                          max-width: 100% !important;
                        }
                      }
                    {%- endstyle -%}
                  {%- endif -%}
                {%- endfor -%}

            {% comment %} {%
              render 'available-benefits',
              block: block,
              section: section,
              product: product
            %} {% endcomment %}

          {%- when 'image' -%}
            {% if block.settings.image != blank %}
            {% liquid
              assign loading = 'lazy'
              assign fetch_priority = 'auto'
              if section.index < 3 and forloop.index < 3
                assign loading = 'eager'
                assign fetch_priority = 'high'
              endif
             %}
            <div class="product__section--image product__section--element" {{ block.shopify_attributes }}>
              {% if block.settings.link != blank %}<a href="{{ block.settings.link }}">{% endif %}
                  {%
                    render 'basic-responsive-image',
                    type: block.settings.image,
                    width: 2400,
                    loading: loading,
                    fetchpriority: fetch_priority
                  %}
              {% if block.settings.link != blank %}</a>{% endif %}
            </div>
            {% endif %} 

          {%- when 'share' -%}
            {% comment %}
            <div class="product__section--share product__share-container product__section--element" {{ block.shopify_attributes }}>
              {% render 'social' with product %}
            </div>
            {% endcomment %}
                 
          {%- when 'product_info_image' -%}
            {% comment %} Rendered below accordion {% endcomment %}

          {%- when 'promo_alert' -%}
            {% liquid
              assign icon = block.settings.icon
              assign type = 'fash-theme'
              case icon
              when 'bag', 'cart', 'chat', 'checkmark', 'gift', 'grid', 'home', 'menu-dots', 'money', 'promo', 'sale-tag', 'search', 'secure', 'share', 'ship-truck', 'star', 'user', 'wish', 'wish-focus'
                assign type = 'apollo'
              endcase
            %}
            {% unless block.settings.text == blank %}
              <div class="product__section--promo-alert product__section--element" {{ block.shopify_attributes }} style="background-color: {{ block.settings.background_color }}; color: {{ block.settings.text_color }}; border: 1px solid {{ block.settings.border_color }};">
                <div class="promo-alert__icon">
                  {% render 'snip-icons',
                    wrapper: '.promo-alert__icon',
                    type: type,
                    icon: icon,
                    size: '18px',
                    fill: block.settings.text_color,
                    hover: block.settings.text_color %}
                </div>
                <div class="promo-alert__text">
                  {{ block.settings.text }}
                </div>
              </div>
            {% endunless %}

          {% when '@app' %}
            <div class="product__section--app product__section--element {{ block.shopify_attributes }}">
              {% render block %}
            </div>

          {% when 'custom_liquid' %}
            <div class="product__section--custom_liquid product__section--element {{ block.shopify_attributes }}">
              {{ section.settings.custom_liquid }}
            </div>
          {% endcase %}

        {%- endfor -%}
<div class="content_accordion">
                  <ul class="accordion">
                    {% if product.description != blank %}
                      <li class="accordion-item is-active">
                        <h5 class="accordion-thumb">Description</h5>
                        <div class="accordion-panel"><p>{{ product.description }}</p></div>
                      </li>
                    {% endif %}
                    {% if product.metafields.custom.fabric_composition != blank %}
                      <li class="accordion-item">
                        <h5 class="accordion-thumb">Fabric & Composition</h5>
                        <div class="accordion-panel"><p>{{ product.metafields.custom.fabric_composition }}</p></div>
                      </li>
                    {% endif %}
                    {% if product.metafields.custom.product_feature != blank %}
                    <li class="accordion-item">
                        <h5 class="accordion-thumb">Product Feature</h5>
                        <div class="accordion-panel">
                            {% assign product_feature_array = product.metafields.custom.product_feature.value %}
                            <ul class="product-feature-list" id="product-feature-{{ product.id }}" data-raw="{% for item in product_feature_array %}{{ item | remove: '"' | strip }}|||{% endfor %}">
                            </ul>
                        </div>
                    </li>
                    <script>
                      (function() {
                        var list = document.getElementById('product-feature-{{ product.id }}');
                        if (!list) return;

                        var raw = list.getAttribute('data-raw') || '';
                        var items = raw.split('|||').map(function(s) { return s.replace(/"/g, '').trim(); }).filter(Boolean);

                        function splitGeneric(text) {
                          text = text.replace(/"/g, '').trim();
                          if (text.length < 15) return [text];

                          var hasPunctuation = /[\n;•\u00b7]|\.\s+/.test(text);

                          if (hasPunctuation) {
                            var lines = text.split(/[\n;•\u00b7]|\s+[-*]\s+/);
                            var results = [];
                            lines.forEach(function(line) {
                              var sentences = line.split(/\.\s+/);
                              sentences.forEach(function(s) {
                                s = s.trim().replace(/\.$/, '');
                                if (s) results.push(s);
                              });
                            });
                            return results;
                          }

                          var words = text.split(/\s+/);
                          var results = [];
                          var current = [];

                          for (var i = 0; i < words.length; i++) {
                            var word = words[i];
                            var isCapitalized = /^[A-Z][a-z]/.test(word);

                            if (isCapitalized && current.length > 0) {
                              var lastWord = current[current.length - 1];
                              var precededByLowercase = /[a-z]$/.test(lastWord);

                              if (precededByLowercase || current.length >= 2) {
                                results.push(current.join(' '));
                                current = [word];
                                continue;
                              }
                            }
                            current.push(word);
                          }

                          if (current.length > 0) {
                            results.push(current.join(' '));
                          }

                          return results;
                        }

                        var bullets = [];
                        if (items.length === 1) {
                          bullets = splitGeneric(items[0]);
                        } else {
                          bullets = items;
                        }

                        var html = '';
                        bullets.forEach(function(b) {
                          var clean = b.replace(/"/g, '').trim().replace(/[.,]+$/, '');
                          if (clean) html += '<li>' + clean + '</li>';
                        });
                        list.innerHTML = html;
                      })();
                    </script>
                    {% endif %}
                      {% if product.metafields.custom.wash_care != blank %}
                        <li class="accordion-item">
                          <h5 class="accordion-thumb">Washcare</h5>
                          <div class="accordion-panel">
                            {% assign wash_care_value = product.metafields.custom.wash_care.value %}
                            {%- comment -%}
                              Output raw items as JSON-safe data. JS will handle smart splitting.
                              Handles both List (multiple items) and a single long string.
                            {%- endcomment -%}
                            <ul class="wash-care-list" id="wash-care-{{ product.id }}" data-raw="{% for item in wash_care_value %}{{ item | remove: '"' | strip }}|||{% endfor %}">
                            </ul>
                          </div>
                        </li>
                        <script>
                          (function() {
                            var list = document.getElementById('wash-care-{{ product.id }}');
                            if (!list) return;

                            var raw = list.getAttribute('data-raw') || '';
                            var items = raw.split('|||').map(function(s) { return s.replace(/"/g, '').trim(); }).filter(Boolean);

                            function splitGeneric(text) {
                              text = text.replace(/"/g, '').trim();
                              if (text.length < 15) return [text];

                              var hasPunctuation = /[\n;•\u00b7]|\.\s+/.test(text);

                              if (hasPunctuation) {
                                var lines = text.split(/[\n;•\u00b7]|\s+[-*]\s+/);
                                var results = [];
                                lines.forEach(function(line) {
                                  var sentences = line.split(/\.\s+/);
                                  sentences.forEach(function(s) {
                                    s = s.trim().replace(/\.$/, '');
                                    if (s) results.push(s);
                                  });
                                });
                                return results;
                              }

                              var words = text.split(/\s+/);
                              var results = [];
                              var current = [];

                              for (var i = 0; i < words.length; i++) {
                                var word = words[i];
                                var isCapitalized = /^[A-Z][a-z]/.test(word);

                                if (isCapitalized && current.length > 0) {
                                  var lastWord = current[current.length - 1];
                                  var precededByLowercase = /[a-z]$/.test(lastWord);

                                  if (precededByLowercase || current.length >= 2) {
                                    results.push(current.join(' '));
                                    current = [word];
                                    continue;
                                  }
                                }
                                current.push(word);
                              }

                              if (current.length > 0) {
                                results.push(current.join(' '));
                              }

                              return results;
                            }

                            var bullets = [];
                            if (items.length === 1) {
                              bullets = splitGeneric(items[0]);
                            } else {
                              bullets = items;
                            }

                            // Render
                            var html = '';
                            bullets.forEach(function(b) {
                              var clean = b.replace(/"/g, '').trim().replace(/[.,]+$/, '');
                              if (clean) html += '<li>' + clean + '</li>';
                            });
                            list.innerHTML = html;
                          })();
                        </script>
                      {% endif %}
                  </ul>
                  
                </div>

       
                {%- for block in section.blocks -%}
                  {%- if block.type == 'shop_the_look' -%}
                    <div class="product__section--shop_the_look product__section--element" {{ block.shopify_attributes }}>
                      {%
                        render 'shop-the-look',
                        block: block,
                        section: section,
                        product: product
                      %}
                    </div>
                  {%- endif -%}
                {%- endfor -%}
      </div>
    </div>
  </div>

  <style>
    .product__section-container {
        background: {{ section.settings.product_background }};
        padding-top: 20px;
        padding-bottom: 20px;
    }
    .product__section-container .contact__form--input label,
    .theme-features__ghost-buttons--true .product__section-container .secondary-button,
    small.property--required {
      background: {{ section.settings.product_background }} !important;
    }
    {% if section.settings.thumbnail_position == 'bottom' %}
      #product-{{ product.id }} .thumb-slider-slides {
        transition: left 0.5s ease-in-out;
      }
    {% else %}
      #product-{{ product.id }} .thumb-slider-slides {
        transition: top 0.5s ease-in-out;
      }
    {% endif %}

  </style>

  {%- liquid
    assign mhy_sticky_discount = 0
    if current_variant.compare_at_price > current_variant.price and current_variant.compare_at_price > 0
      assign mhy_sticky_discount = current_variant.compare_at_price | minus: current_variant.price | times: 100.0 | divided_by: current_variant.compare_at_price | round
    endif
  -%}

  <div class="mhy-sticky-atc" data-mhy-sticky-atc hidden>
    <div class="mhy-sticky-atc__inner">
      
      <!-- 1. Product Image Thumbnail -->
      {% if product.featured_media.preview_image != blank %}
        <a href="{{ product.url }}" class="mhy-sticky-atc__image-link" aria-label="View product">
          <img class="mhy-sticky-atc__image" data-mhy-sticky-image src="{{ product.featured_media.preview_image | image_url: width: 160 }}" alt="{{ product.title | escape }}" width="80" height="80" loading="lazy" />
        </a>
      {% endif %}
      
      <!-- 2. Product Info -->
      <div class="mhy-sticky-atc__info">
        {% if product.vendor != blank %}
          <div class="mhy-sticky-atc__vendor">{{ product.vendor }}</div>
        {% endif %}
        <div class="mhy-sticky-atc__title">{{ product.title }}</div>
        <div class="mhy-sticky-atc__selections">
          {%- for option in product.options_with_values -%}
            <span class="mhy-sticky-atc__selection-item" data-sticky-option-index="{{ forloop.index0 }}">
              <span class="mhy-sticky-atc__selection-label">{{ option.name }}:</span>
              <span class="mhy-sticky-atc__selection-value" data-sticky-option-value="{{ forloop.index0 }}">{{ option.selected_value }}</span>
            </span>
          {%- endfor -%}
        </div>
      </div>
      
      <!-- 3. Price & Discount Block -->
      <div class="mhy-sticky-atc__price-block">
        <div class="mhy-sticky-atc__pricing" data-mhy-sticky-pricing>
          <div class="mhy-sticky-atc__price-current" data-mhy-sticky-price-current>{{ current_variant.price | money }}</div>
          <div class="mhy-sticky-atc__sale-info" data-mhy-sticky-sale-info{% if current_variant.compare_at_price <= current_variant.price %} hidden{% endif %}>
            <span class="mhy-sticky-atc__price-compare" data-mhy-sticky-price-compare>{{ current_variant.compare_at_price | money }}</span>
            <span class="mhy-sticky-atc__save" data-mhy-sticky-save>Save {{ mhy_sticky_discount }}%</span>
          </div>
        </div>
      </div>

      <!-- 4. Premium Quantity Selector -->
      <div class="mhy-sticky-atc__qty-selector">
        <button type="button" class="mhy-sticky-atc__qty-btn" data-qty-decrement aria-label="Decrease quantity">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/></svg>
        </button>
        <span class="mhy-sticky-atc__qty-value" data-mhy-sticky-qty-value>1</span>
        <button type="button" class="mhy-sticky-atc__qty-btn" data-qty-increment aria-label="Increase quantity">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        </button>
      </div>

      <!-- 5. Actions Wrapper -->
      <div class="mhy-sticky-atc__actions">
        {% if product.variants.size > 1 %}
          <select class="mhy-sticky-atc__variant-select" data-mhy-sticky-variant-select aria-label="Select variant">
            {% for variant in product.variants %}
              <option value="{{ variant.id }}" {% if variant == current_variant %}selected{% endif %} {% unless variant.available %}disabled{% endunless %}>
                {{ variant.title }}
              </option>
            {% endfor %}
          </select>
        {% endif %}
        <button class="mhy-sticky-atc__btn" type="button" data-mhy-sticky-atc-btn>
          <span class="mhy-sticky-atc__btn-text">{{ 'products.product.add_to_cart' | t }}</span>
          <span class="mhy-sticky-atc__btn-loader" hidden>
            <svg class="mhy-spinner" viewBox="0 0 50 50">
              <circle class="path" cx="25" cy="25" r="20" fill="none" stroke="currentColor" stroke-width="5"></circle>
            </svg>
          </span>
        </button>
      </div>
      
    </div>
  </div>
</section>

<!-- PDP Custom Share Modal -->
