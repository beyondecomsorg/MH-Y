
{% style %}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.desktop_padding_top }}px !important;
    padding-bottom: {{ section.settings.desktop_padding_bottom }}px !important;
  }
  @media screen and (max-width: 740px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.mobile_padding_top }}px !important;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px !important;
    }
  }
{% endstyle %}

{%- liquid

  assign section_padding = ''
  if section.settings.section_padding == 'top'
    assign section_padding = 'pb0'
  elsif section.settings.section_padding == 'bottom'
    assign section_padding = 'mt0'
  elsif section.settings.section_padding == 'none'
    assign section_padding = 'mt0 pb0'
  endif

  assign is_swipe = false
  assign is_touching = false

  if section.settings.swipe
    assign is_swipe = true
  endif

  if section.settings.images_touching
    assign is_touching = true
  endif

  assign single_block = true

  if section.blocks.size > 1
    assign single_block = false
  endif

  assign use_fifths_grid = false

  for block in section.blocks
    case block.settings.image_width
      when '25%' or '75%'
        assign use_fifths_grid = true
        break
     endcase
  endfor

  assign fixed_height = false
  if section.settings.image_height == 'fixed_height'
    assign fixed_height = true
  endif

  assign desktop_height = section.settings.desktop_height
  assign mobile_height = section.settings.mobile_height

-%}

<style>
  #shopify-section-{{ section.id }} .gallery__section-container.images_touching {
    grid-gap: 0;
  }
  #shopify-section-{{ section.id }} .gallery__section-container.mobile__swipe.images_touching .gallery__section-block {
    margin-right: 0;
  }

  #shopify-section-{{ section.id }} {
    --h3-size:  {{ section.settings.heading_size }}px;
    --font-size:  {{ section.settings.subheading_size }}px;
    {% if fixed_height %}
      --desktop-section-height: {{ desktop_height }}px;
      --mobile-section-height: {{ mobile_height }}px;
    {% endif %}
  }
  @media screen and (max-width: 740px) {
    #shopify-section-{{ section.id }} {
      --h3-size:  calc({{ section.settings.heading_size }}px - ({{ section.settings.heading_size }}px * 0.15));
      --font-size:  calc({{ section.settings.subheading_size }}px - ({{ section.settings.subheading_size }}px * 0.15));
    }
  }
  {% for block in section.blocks %}
    #shopify-section-{{ section.id }} .gallery__section-block.promo-{{ block.id }} {
      --section-overlay-color: {{ block.settings.overlay_color | color_to_rgb | remove: 'rgb(' | remove: ')' }};
      --section-overlay-opacity: {{ block.settings.overlay_opacity | plus: 0 | divided_by: 100.0  }};
      --caption-background: {{ block.settings.caption_background }};
      --text-color: {{ block.settings.text_color }};
    }
  {% endfor %}
  @media screen and (max-width: 740px) {
    .global__section .gallery__section-container.mobile__swipe {
        flex-wrap: wrap !important;
    }
    .image_gallery__section_block{
      width: 100% !important;
    }
    .gallery__section-container{
      padding-top: 0px !important;
    }
  }
</style>

<section class="global__section gallery__section {{ section.id }} {{ section_padding }}" data-section-id="{{ section.id }}" data-aos="fade">
  {% if section.settings.full_width %}<div class=""><div class="row" style="width:100%;">{% endif %}
    {% if section.settings.heading != blank %}
      <h2 class="section-heading">{{ section.settings.heading }}</h2>
    {% endif %}
  <div class="gallery__section-container row grid__wrapper{% if is_swipe %} mobile__swipe{% endif %}{% if is_touching %} images_touching{% endif %}{% if fixed_height %} is-fixed_height{% endif %} {% if single_block and use_fifths_grid %}wrapper-fifths{% endif %}">
    {% for block in section.blocks %}
      {%- liquid
         case block.settings.image_width
          when '25%'
            if single_block
              assign image_width = 'span-3 push-6'
            else
              assign image_width = 'span-3'
            endif
            assign md_render = 'calc(100vw / 4)'
            assign lg_render = 'calc(1600px / 4)'
          when '33%'
            if single_block
              assign image_width = 'span-4 push-4'
            else
              assign image_width = 'span-4'
            endif
            assign md_render = 'calc(100vw / 3)'
            assign lg_render = 'calc(1600px / 3)'
          when '50%'
            if single_block
              assign image_width = 'span-6 push-3'
            else
              assign image_width = 'span-6'
            endif
            assign md_render = 'calc(100vw / 2)'
            assign lg_render = 'calc(1600px / 2)'
          when '66%'
            if single_block
              assign image_width = 'span-8 push-2'
            else
              assign image_width = 'span-8'
            endif
            assign md_render = 'calc(100vw * 0.6667)'
            assign lg_render = 'calc(1600px * 0.6667)'
          when '75%'
            if single_block
              # assign image_width = 'span-9 push-3'
              assign image_width = 'span-11 push-2 '
            else
              assign image_width = 'span-9'
            endif
            assign md_render = 'calc(100vw * 0.75)'
            assign lg_render = 'calc(1600px * 0.75)'
          when '100%'
            assign image_width = 'span-12'
            assign md_render = '100vw'
            assign lg_render = '100vw'
         endcase

         assign hide_caption = false
         if block.settings.heading == blank and block.settings.subheading == blank and block.settings.button_text == blank
          assign hide_caption = true
         endif

         assign hover_caption = false
         if block.settings.hover_caption
          assign hover_caption = true
        endif

        assign caption_position = block.settings.caption_position

        assign alt_heading = block.settings.heading | strip_html | strip
        assign alt_subheading = block.settings.subheading | strip_html | strip
        assign gallery_alt_base = alt_heading
        if gallery_alt_base == blank
          assign gallery_alt_base = alt_subheading
        elsif alt_subheading != blank
          assign gallery_alt_base = gallery_alt_base | append: ' – ' | append: alt_subheading
        endif
        if gallery_alt_base == blank and section.settings.heading != blank
          assign gallery_alt_base = section.settings.heading | strip_html | strip | append: ' Image ' | append: forloop.index
        endif
        if gallery_alt_base == blank and block.settings.link contains '/collections/'
          assign collection_handle = block.settings.link | split: '/collections/' | last | split: '?' | first | split: '/' | first | replace: '-', ' ' | strip
          if collection_handle != blank
            assign gallery_alt_base = collection_handle | append: ' Collection Image'
          endif
        endif
        if gallery_alt_base == blank
          assign gallery_alt_base = 'Lifestyle Image ' | append: forloop.index
        endif
        if gallery_alt_base contains 'MH&Y'
          assign gallery_alt = gallery_alt_base
        else
          assign gallery_alt = gallery_alt_base | append: ' by MH&Y India'
        endif

        assign loading = 'lazy'
        assign fetch_priority = 'auto'
        if section.index == 1
          assign fetch_priority = 'high'
          assign loading = 'eager'
        endif

      -%}

      <div class="image_gallery__section_block gallery__section-block {% if section.settings.full_width and block.settings[image_size] == '100%' %} centered{% endif %} {{ image_width }} {% unless is_swipe %}sm-span-12 {% endunless %} auto promo-{{ block.id }}{% if forloop.last %} last-block{% endif %}" 
        data-aos="fade"
        data-aos-delay="{{ forloop.index | times: 100 }}"
        {{ block.shopify_attributes }}>
        
        {% if block.settings.link != blank and block.settings.button_text == blank %}
        <a href="{{ block.settings.link }}">
        {% endif %}
        <div class="gallery__section-content{% if hover_caption and hide_caption == false %} hover__caption{% endif %}">
          <div class="gallery__section-image">
            {% if block.settings.image != blank %}
              {%
                render 'basic-responsive-image',
                type: block.settings.image,
                sm_render: '300px',
                md_render: md_render,
                lg_render: lg_render,
                width: 1200,
                alt: gallery_alt,
                loading: loading,
                fetchpriority: fetch_priority
              %}
            {% else %}
              <div class="onboard">
                {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
              </div>
            {% endif %}
          </div>

          {% unless hide_caption %}
            <div class="gallery__image-caption image__caption {{ caption_position }}">
              {% if block.settings.heading != blank %}
                <h3>{{ block.settings.heading | escape }}</h3>
              {% endif %}
              {% if block.settings.subheading != blank %}
                <p>{{ block.settings.subheading | escape }}</p>
              {% endif %}
              {% if block.settings.link != blank and block.settings.button_text != blank %}
                <div class="caption__btn-wrapper">
                  <a class="button" href="{{ block.settings.link }}">
                    {{ block.settings.button_text }}
                  </a>
                </div>
              {% endif %}
            </div>
          {% endunless %}
        </div>
        {% if block.settings.link != blank and block.settings.button_text == blank %}
        </a>
        {% endif %}
      </div>
    {% endfor %}
  </div>
  {% if section.settings.full_width %}</div></div>{% endif %}

  {% if section.blocks.size == 0 %}
    {% render 'no-blocks' %}
  {% endif %}
</section>
<div class="clear"></div>

{% schema %}
{
  "name": "Image gallery",
  "class": "header__overlay-banner",
  "settings": [
    {
      "type": "range",
      "id": "desktop_padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Section Top Padding (Desktop)",
      "default": 30
    },
    {
      "type": "range",
      "id": "desktop_padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Section Bottom Padding (Desktop)",
      "default": 30
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Section Top Padding (Mobile)",
      "default": 15
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Section Bottom Padding (Mobile)",
      "default": 15
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Enable full width",
      "default": false
    },
    {
      "type": "radio",
      "id": "image_height",
      "label": "Image height",
      "options": [
        {
          "value": "natural",
          "label": "Natural"
        },
        {
          "value": "fixed_height",
          "label": "Fixed height"
        }
      ]
    },
    {
      "type": "range",
      "id": "desktop_height",
      "min": 200,
      "max": 1000,
      "step": 50,
      "unit": "px",
      "label": "Desktop fixed height",
      "default": 900
    },
    {
      "type": "range",
      "id": "mobile_height",
      "min": 200,
      "max": 1000,
      "step": 100,
      "unit": "px",
      "label": "Mobile fixed height",
      "default": 600
    },
    {
      "type": "checkbox",
      "id": "swipe",
      "label": "Swipe images on mobile"
    },
    {
      "type": "checkbox",
      "id": "images_touching",
      "label": "Images touching",
      "info":"Remove the space around images"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 13,
      "max": 36,
      "step": 1,
      "unit": "px",
      "label": "Heading size",
      "default": 22
    },
    {
      "type": "range",
      "id": "subheading_size",
      "min": 13,
      "max": 36,
      "step": 1,
      "unit": "px",
      "label": "Subheading size",
      "default": 14
    },
    {
      "type": "select",
      "id": "section_padding",
      "label": "Section spacing",
      "options": [
        {
          "value": "top",
          "label": "Top"
        },
        {
          "value": "bottom",
          "label": "Bottom"
        },
        {
          "value": "both",
          "label": "Both"
        },
        {
          "value": "none",
          "label": "None"
        }
      ],
      "default": "both"
    }
  ],
  "blocks": [{
    "type": "image",
    "name": "Image",
    "settings": [{
        "type": "image_picker",
        "id": "image",
        "label": "Image",
        "info": "800px x 600px recommended"
      },
      {
        "type": "select",
        "id": "image_width",
        "label": "Width",
        "default": "33%",
        "options": [{
            "value": "25%",
            "label": "25%"
          },
          {
            "value": "33%",
            "label": "33%"
          },
          {
            "value": "50%",
            "label": "50%"
          },
          {
            "value": "66%",
            "label": "66%"
          },
          {
            "value": "75%",
            "label": "75%"
          },
          {
            "value": "100%",
            "label": "100%"
          }
        ]
      },
      {
        "type": "url",
        "id": "link",
        "label": "Link"
      },
      {
        "type": "header",
        "content": "Caption"
      },
      {
        "type": "text",
        "id": "heading",
        "label": "Heading",
        "default": "Heading"
      },
      {
        "type": "text",
        "id": "subheading",
        "label": "Subheading",
        "default": "Subheading"
      },
      {
        "id": "button_text",
        "type": "text",
        "label": "Button text",
        "default": "Button",
        "info": "Visible only if a link is chosen"
      },
      {
        "type": "header",
        "content": "Caption style"
      },
      {
        "type": "select",
        "id": "caption_position",
        "label": "Caption position",
        "default": "middle_center",
        "options": [
          {
            "value": "top_left",
            "label": "Top left"
          },
          {
            "value": "top_center",
            "label": "Top center"
          },
          {
            "value": "top_right",
            "label": "Top right"
          },
          {
            "value": "middle_left",
            "label": "Middle left"
          },
          {
            "value": "middle_center",
            "label": "Middle center"
          },
          {
            "value": "middle_right",
            "label": "Middle right"
          },
          {
            "value": "bottom_left",
            "label": "Bottom left"
          },
          {
            "value": "bottom_center",
            "label": "Bottom center"
          },
          {
            "value": "bottom_right",
            "label": "Bottom right"
          }
        ]
      },
      {
        "type": "checkbox",
        "id": "hover_caption",
        "label": "Show on hover only",
        "info":"Hides the caption until the image is hovered. Displays at all times on mobile"
      },
      {
        "type": "color",
        "id": "caption_background",
        "label": "Caption background",
        "default": "transparent"
      },
      {
        "type": "color",
        "id": "text_color",
        "label": "Text color",
        "default": "#ffffff"
      },
      {
        "type": "color",
        "id": "overlay_color",
        "label": "Overlay color",
        "default": "#000000"
      },
      {
        "type": "range",
        "id": "overlay_opacity",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "%",
        "label": "Overlay opacity",
        "default": 0
      }
    ]
  }],
  "presets": [{
    "name": "Image gallery",
    "blocks": [{
        "type": "image"
      },
      {
        "type": "image"
      },
      {
        "type": "image"
      }
    ]
  }],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
