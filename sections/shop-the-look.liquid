{% comment %}
  ==============================================================================
  SECTION: shop-the-look.liquid
  ==============================================================================
  Renders "Shop the Look" & "Discover More" complementary products carousel as a standalone section.
{% endcomment %}

<div class="shopify-section--shop-the-look-wrapper" style="max-width: {{ section.settings.max_width }}px; margin: 0 auto; padding: {{ section.settings.padding_top }}px 24px {{ section.settings.padding_bottom }}px;">
  {% render 'shop-the-look', block: section, section: section, product: product %}
</div>

{% schema %}
{
  "name": "Shop the Look Section",
  "class": "shopify-section--shop-the-look",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "tab1_title",
      "label": "Tab 1 Title",
      "default": "SHOP THE LOOK"
    },
    {
      "type": "text",
      "id": "tab2_title",
      "label": "Tab 2 Title",
      "default": "DISCOVER MORE"
    },
    {
      "type": "select",
      "id": "rec_method",
      "label": "Recommendation Method",
      "options": [
        { "value": "both", "label": "Native Complementary + Category Rule Fallback" },
        { "value": "native", "label": "Native Complementary Only" },
        { "value": "rule_based", "label": "Category Rule Fallback Only" }
      ],
      "default": "both"
    },
    {
      "type": "collection",
      "id": "fallback_collection",
      "label": "Fallback / Discover More Collection"
    },
    {
      "type": "range",
      "id": "limit",
      "min": 2,
      "max": 10,
      "step": 1,
      "label": "Maximum products to show",
      "default": 6
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 600,
      "max": 1400,
      "step": 40,
      "unit": "px",
      "label": "Maximum width",
      "default": 1200
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 32
    }
  ],
  "presets": [
    {
      "name": "Shop the Look Section",
      "settings": {
        "tab1_title": "SHOP THE LOOK",
        "tab2_title": "DISCOVER MORE",
        "rec_method": "both"
      }
    }
  ]
}
{% endschema %}
