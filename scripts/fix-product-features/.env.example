# Shopify Store Domain (e.g., my-store.myshopify.com or my-store)
SHOPIFY_STORE=your-store.myshopify.com

# Shopify Admin API Access Token (shpat_xxxxxxxxxxxxxxxxxxxxxxxx)
SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxx

# Optional: API Version (Defaults to 2024-10 if not set)
SHOPIFY_API_VERSION=2024-10
